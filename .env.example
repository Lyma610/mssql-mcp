# SQL Server connection
# Optional: provide a complete ODBC connection string instead of the fields below.
# MSSQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:sql.example.test,1433;Database=analytics;UID=mcp_reader;PWD=replace-with-a-secret;Encrypt=yes;TrustServerCertificate=no;ApplicationIntent=ReadOnly;

MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_SERVER=localhost
MSSQL_DATABASE=master

# Authentication: use trusted connection, or set it to no and provide credentials.
MSSQL_TRUSTED_CONNECTION=yes
MSSQL_USERNAME=
MSSQL_PASSWORD=

# TLS and routing
MSSQL_ENCRYPT=yes
MSSQL_TRUST_CERTIFICATE=no
MSSQL_APPLICATION_INTENT=ReadOnly

# Resource limits
MSSQL_TIMEOUT_CONNECTION=10
MSSQL_TIMEOUT_QUERY=30
MSSQL_MAX_ROWS=100
MSSQL_MAX_QUERY_LENGTH=10000

# State-changing SQL is disabled by default. Enabling it also requires
# MSSQL_APPLICATION_INTENT=ReadWrite and an explicitly permissioned identity.
MSSQL_ENABLE_WRITE_TOOLS=no
MSSQL_ALLOWED_WRITE_OPERATIONS=INSERT,UPDATE,DELETE
MSSQL_MAX_AFFECTED_ROWS=100
MSSQL_CHANGE_TOKEN_TTL_SECONDS=300
MSSQL_MAX_PENDING_CHANGES=100

# MCP and logging
MCP_SERVER_NAME=Microsoft SQL Server Explorer
LOG_LEVEL=INFO
LOG_FORMAT=plain
# LOG_FILE=logs/mssql-mcp.log
