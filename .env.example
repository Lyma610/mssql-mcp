# Required
MSSQL_SERVER=localhost
MSSQL_DATABASE=MyDatabase
MSSQL_AUTH=windows

# SQL Authentication alternative
# MSSQL_AUTH=sql
# MSSQL_USERNAME=user
# MSSQL_PASSWORD=

# Optional / Advanced
# MSSQL_DRIVER=ODBC Driver 18 for SQL Server
# MSSQL_ENCRYPT=yes
# MSSQL_TRUST_CERTIFICATE=yes
# MSSQL_APPLICATION_INTENT=ReadOnly
# MSSQL_ENABLE_WRITE_TOOLS=no
# MSSQL_TIMEOUT_CONNECTION=10
# MSSQL_TIMEOUT_QUERY=30
# MSSQL_MAX_ROWS=500
# MSSQL_MAX_QUERY_LENGTH=10000

# Additional write controls (only relevant when write tools are explicitly enabled)
# MSSQL_ALLOWED_WRITE_OPERATIONS=INSERT,UPDATE,DELETE
# MSSQL_MAX_AFFECTED_ROWS=100
# MSSQL_CHANGE_TOKEN_TTL_SECONDS=300
# MSSQL_MAX_PENDING_CHANGES=100

# Runtime and logging
# MCP_SERVER_NAME=Microsoft SQL Server Explorer
# LOG_LEVEL=INFO
# LOG_FORMAT=plain
# LOG_FILE=logs/mssql-mcp.log
